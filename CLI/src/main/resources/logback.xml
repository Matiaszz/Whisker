<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <root level="OFF">
        <appender-ref ref="STDOUT" />
    </root>

    <logger name="dev.whisker" level="INFO" />
    <logger name="com.rabbitmq" level="OFF" />
</configuration>
